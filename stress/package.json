{
  "name": "within-stress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stress tests for @getwithin/sdk 0.4.0, run against a local stand-in for Within's API",
  "scripts": {
    "test": "node run.mjs",
    "test:model": "node model/run-model.mjs",
    "patch": "node patches/apply.mjs",
    "test:patched": "node patches/apply.mjs && WITHIN_SDK_ENTRY=$PWD/patched-sdk/dist/index.js node run.mjs",
    "build:sketches": "node sketches.mjs",
    "build:map": "node map.mjs",
    "build:report": "node build.mjs",
    "build:all": "node sketches.mjs && node map.mjs && node build.mjs"
  },
  "dependencies": {
    "@getwithin/sdk": "0.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76"
  }
}
