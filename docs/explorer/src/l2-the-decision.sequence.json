{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "One buying question, step by step",
    "output": "l2-the-decision.html",
    "viewBox": [
      1000,
      600
    ],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "decision",
        "label": "Decision",
        "focus": [
          "customer",
          "model",
          "sdk"
        ],
        "note": "Step 2 is the model's choice. Nothing forces it, only written instructions."
      },
      {
        "id": "answer",
        "label": "Answer",
        "focus": [
          "model",
          "sdk",
          "api"
        ],
        "note": "Within returns the vendor's saved answer, not the model's guess."
      },
      {
        "id": "consent",
        "label": "Consent",
        "focus": [
          "customer",
          "model",
          "sdk",
          "api"
        ],
        "note": "Within's promise: a rep joins only after the customer says yes. See W-18 for what the SDK itself checks."
      },
      {
        "id": "newer-parts",
        "label": "Newer parts",
        "focus": [
          "model",
          "sdk",
          "api"
        ],
        "note": "New: Within's invitation line (hubs on; repeated in 40 of 40 runs) and report_void (topics only)."
      }
    ]
  },
  "participants": [
    {
      "id": "customer",
      "type": "external",
      "label": "Customer",
      "sublabel": "in the chat"
    },
    {
      "id": "model",
      "type": "external",
      "label": "Claude / ChatGPT",
      "sublabel": "the model"
    },
    {
      "id": "sdk",
      "type": "backend",
      "label": "Within SDK",
      "sublabel": "in the vendor's server"
    },
    {
      "id": "api",
      "type": "cloud",
      "label": "Within API",
      "sublabel": "app.getwith.in"
    }
  ],
  "messages": [
    {
      "id": "m1",
      "from": "customer",
      "to": "model",
      "y": 166,
      "label": "asks the price for 40 seats",
      "variant": "default"
    },
    {
      "id": "m2",
      "from": "model",
      "to": "sdk",
      "y": 194,
      "label": "get_vendor_answer (the model's choice)",
      "variant": "emphasis"
    },
    {
      "id": "m3",
      "from": "sdk",
      "to": "api",
      "y": 222,
      "label": "POST /v1/answers",
      "variant": "default"
    },
    {
      "id": "m4",
      "from": "api",
      "to": "sdk",
      "y": 250,
      "label": "saved answer",
      "variant": "return"
    },
    {
      "id": "m4b",
      "from": "sdk",
      "to": "api",
      "y": 278,
      "label": "/v1/hubs/invite (only if hubs is on)",
      "variant": "default"
    },
    {
      "id": "m4c",
      "from": "api",
      "to": "sdk",
      "y": 306,
      "label": "an invitation line, written by Within",
      "variant": "return"
    },
    {
      "id": "m5",
      "from": "sdk",
      "to": "model",
      "y": 334,
      "label": "answer + offer card",
      "variant": "return"
    },
    {
      "id": "m6",
      "from": "model",
      "to": "customer",
      "y": 362,
      "label": "price, and a card offering a person",
      "variant": "return"
    },
    {
      "id": "m7",
      "from": "customer",
      "to": "model",
      "y": 390,
      "label": "says yes on the card",
      "variant": "default"
    },
    {
      "id": "m8",
      "from": "model",
      "to": "sdk",
      "y": 418,
      "label": "confirm_assistance",
      "variant": "emphasis"
    },
    {
      "id": "m9",
      "from": "sdk",
      "to": "api",
      "y": 446,
      "label": "/v1/offers accept, a rep joins",
      "variant": "default"
    },
    {
      "id": "m10",
      "from": "model",
      "to": "sdk",
      "y": 474,
      "label": "report_void: what the customer asked",
      "variant": "emphasis"
    },
    {
      "id": "m11",
      "from": "sdk",
      "to": "api",
      "y": 502,
      "label": "/v1/activity, the phrase as written",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "The weak spot (W-20)",
      "items": [
        "Step 2 rests on about 2,900 characters of instructions",
        "Haiku 5.5: 11 of 30 runs on 0.4.0",
        "Sonnet 5.5: 0 of 10 on both versions"
      ]
    },
    {
      "dot": "emerald",
      "title": "What held up",
      "items": [
        "Recall 30 of 30 on 0.4.0",
        "Spanish, German, rate-limit, relayed, renewal questions all reached Within (15 of 15 now)",
        "Reworded trigger: false alarm 0 of 30 on 0.4.0"
      ]
    }
  ]
}
