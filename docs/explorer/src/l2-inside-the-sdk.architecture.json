  "cards": [
    {
      "dot": "cyan",
      "title": "install() does these things",
      "items": [
        "Appends its note (~2,900 chars) to the server instructions",
        "Replaces ALL vendor text if a banned phrase is in it",
        "Registers 4 tools and 2 card pages (open_hub and hub_card too, if hubs is on)",
        "Patches registerTool",
        "Pings /v1/install, now with the hubs flag"
      ]
    },
    {
      "dot": "amber",
      "title": "Every successful wrapped call, two network calls",
      "items": [
        "Runs the vendor's handler, sends /v1/activity",
        "Then waits on /v1/offers/deliver for a rep's offer (a third call, /v1/hubs/invite, if hubs is on)",
        "Each wait is capped at 5 seconds"
      ]
    },
    {
      "dot": "rose",
      "title": "Findings in this view",
      "items": [
        "W-02 outage alters the vendor's data",
        "W-03 a hung Within slows every successful wrapped call",
        "W-04, W-05 the goal input",
        "W-09 unwrapped tools report",
        "W-10 goal text unredacted",
        "W-15 vendor instructions replaced",
        "W-22 report_void is on by default"
      ]
    }
  ]
