  "cards": [
    {
      "dot": "cyan",
      "title": "The five steps",
      "items": [
        "1  The tool list gains a required context text and one extra tool",
        "2  Every tool call is copied into an event, with arguments and result",
        "3  The vendor's own redaction function, if any, runs on every string",
        "4  The package's filter hides some values, by name or by pattern",
        "5  A queue sends the events, five requests at a time"
      ]
    },
    {
      "dot": "amber",
      "title": "Why step 4 matters most",
      "items": [
        "The email pattern runs on the whole text before it is cut to the size limit. W-01 is the freeze."
      ]
    }
  ]
